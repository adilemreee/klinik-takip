// Copy to `Local.xcconfig` (untracked) and fill in the real host.
//
// The two slashes after https: are written as `https:/$()/` because xcconfig
// treats `//` as the start of a comment — without the empty substitution the
// rest of the line disappears.
KLINIK_API_BASE_URL = https:/$()/klinikapi-staging.example.invalid

// The Apple Developer team the app is signed with.
//
// Here rather than in project.yml because this repository is public. Without
// it `xcodebuild archive` stops at "requires a development team", and signing
// goes back to being something each machine sets in Xcode by hand — which is
// how a Debug archive once reached TestFlight.
DEVELOPMENT_TEAM = ABCDE12345
