<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device (spec section 8). The offline queue holds clinical
  records and the token store holds a live session; neither belongs in a cloud
  backup or on a new phone the user restored from one.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
