# Copy to /opt/klinik/production/.env on the server, fill in, then: chmod 600 .env
# Ports and subnet are allocated in docs/PORTS.md — do not change without
# re-checking for collisions against the other 21 containers on this host.

COMPOSE_PROJECT_NAME=klinik-prod
DOCKER_SUBNET=172.24.0.0/16
IMAGE_TAG=latest

APP_ENV=production
NODE_ENV=production
API_PORT=8120
MINIO_API_PORT=8121
MINIO_CONSOLE_PORT=8122
API_PUBLIC_URL=https://api.klinik.example.com

POSTGRES_DB=klinik
POSTGRES_USER=klinik
POSTGRES_PASSWORD=                  # openssl rand -base64 32
DATABASE_URL=postgresql://klinik:CHANGEME@postgres:5432/klinik?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                     # openssl rand -base64 32

S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=                      # MinIO root user
S3_SECRET_KEY=                      # openssl rand -base64 32
S3_BUCKET_DOCUMENTS=klinik-documents
S3_BUCKET_PHOTOS=klinik-photos
S3_SIGNED_URL_TTL_SECONDS=300

JWT_ACCESS_SECRET=                  # openssl rand -base64 48
JWT_REFRESH_SECRET=                 # openssl rand -base64 48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TOTP_ISSUER=Klinik Takip

# AES-256 key for column-level encryption of TOTP secrets and, later, other
# fields that must stay unreadable in a database dump. Exactly 32 bytes, base64:
#   openssl rand -base64 32
# Losing this key makes every encrypted column unrecoverable — store a copy
# outside the server, like the backup passphrase.
ENCRYPTION_KEY=

# Account lockout (spec section 2)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
INVITATION_TTL_HOURS=72
INVITATION_MAX_ATTEMPTS=5

# AI layer (spec sections 3.4 and 14). Left empty, the layer is off and refuses
# every call — which is the correct state until the terms below are actually in
# place.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Required whenever the layer is on: USD per million tokens, read off the
# provider's pricing for THIS account. Cost accounting is mandatory, so an
# unpriced model keeps the layer switched off rather than spending blind.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_MONTHLY_BUDGET_USD=
# Section 14.5: set to true ONLY once the provider account is under
# zero-retention or business-associate terms. While false, prompts derived from
# patient data are refused rather than sent.
AI_ZERO_RETENTION=false
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1024
# Lets a LOW or MEDIUM lab interpretation reach the patient without a clinician
# reading it first (spec M5). There is deliberately no setting that does this for
# a HIGH or CRITICAL one.
AI_AUTO_RELEASE_LOW_RISK=false
# Embeddings for protocol retrieval, configured separately because Anthropic has
# no embeddings API. Without them the FAQ assistant still works: retrieval falls
# back to the lexical search, and nothing degrades into answering from the
# model's own memory.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_PRICE_PER_MTOK=
# Sends clinical photographs to the model for pre-assessment (spec M5). Off by
# default and separate from the rest of the AI layer: an image cannot be
# minimised the way text can — the scrubber removes a name from a sentence, and
# nothing removes a face or a tattoo from a wound photograph.
AI_PHOTO_ASSESSMENT=false

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=/run/secrets/apns.p8
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm.json

SMS_PROVIDER=
SMS_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Metrics are served on their own port, reachable only on the docker network.
METRICS_PORT=9464
SERVICE_NAME=klinik-api

# Self-hosted GlitchTip (Sentry protocol). Create a project in the GlitchTip UI
# and paste its DSN here. Leave blank to disable error reporting.
SENTRY_DSN=

# Self-hosted Loki. Leave blank to log to stdout only.
LOKI_URL=http://loki:3100

LOG_LEVEL=info
