# Copy to .env and fill in. NEVER commit the real .env.
# On the server this lives at /opt/klinik/<env>/.env with chmod 600.

# ---------- Runtime ----------
NODE_ENV=development
APP_ENV=staging                     # staging | production
API_PORT=8123                       # see docs/PORTS.md
API_PUBLIC_URL=

# ---------- Database ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=klinik
POSTGRES_USER=klinik
POSTGRES_PASSWORD=
DATABASE_URL=

# ---------- Redis / Queue ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Object storage (MinIO) ----------
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_DOCUMENTS=
S3_BUCKET_PHOTOS=
S3_SIGNED_URL_TTL_SECONDS=300

# ---------- Auth ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
TOTP_ISSUER=Klinik Takip

# ---------- AI provider (abstracted, see spec section 3.4) ----------
AI_PROVIDER=                        # anthropic | openai
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_BUDGET_USD=

# ---------- Push notifications ----------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_PATH=                      # path to .p8, never in repo
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=

# ---------- SMS / e-mail fallback ----------
SMS_PROVIDER=
SMS_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ---------- Observability ----------
SENTRY_DSN=
LOG_LEVEL=info
