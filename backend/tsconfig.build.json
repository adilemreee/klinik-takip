{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin the root so the emitted layout is dist/main.js, not dist/src/main.js.
    // Without this, including test/ in the type-check config silently shifts the
    // whole output tree and the container cannot find its entry point.
    "rootDir": "./src",
    // Keep the incremental state inside outDir. Left at the project root it
    // survives a `rm -rf dist`, and tsc then reports "up to date" and emits
    // nothing at all — exiting 0 with no output.
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  // prisma/ holds the schema seed and its permission catalogue: type-checked
  // and linted, but not part of the API bundle.
  "exclude": ["node_modules", "dist", "coverage", "test", "prisma", "scripts", "**/*.spec.ts"]
}
