# Public entry point for the mobile clients.
#
# This host already runs a cloudflared tunnel that terminates TLS at the
# Cloudflare edge and forwards to local ports. Append the entries below to the
# EXISTING /etc/cloudflared/config.yml ingress list — do not rewrite the file.
#
#   1. cp /etc/cloudflared/config.yml /etc/cloudflared/config.yml.bak-$(date +%F-%H%M%S)
#   2. insert these entries BEFORE the final `- service: http_status:404` catch-all
#   3. cloudflared tunnel ingress validate
#   4. systemctl reload cloudflared
#
# Order matters: the catch-all 404 must stay last.

  - hostname: <production-hostname>
    service: http://localhost:8120          # production API

  - hostname: <staging-hostname>
    service: http://localhost:8123          # staging API

# Notes
# -----
# * MinIO, Grafana and Prometheus are deliberately NOT exposed here. They are
#   VPN-only via nginx (see ../nginx/klinik-internal.conf.example).
# * MinIO signed URLs are generated by the API and served through the API host,
#   so the S3 endpoint itself never needs a public hostname.
