{
  "$comment": [
    "Single source of truth for both platforms (spec section 3.2).",
    "Swift and Kotlin sources are generated from this file; neither is edited by hand.",
    "Values follow spec section 7: high contrast, colour-blind safe, dark mode,",
    "and touch targets no smaller than 44pt."
  ],
  "meta": {
    "version": 1,
    "minimumTouchTargetPt": 44,
    "contrastTargetNormalText": 4.5,
    "contrastTargetLargeText": 3.0
  },
  "color": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#F5F6F8",
      "surfaceRaised": "#FFFFFF",
      "border": "#D8DCE3",
      "textPrimary": "#111418",
      "textSecondary": "#4A5361",
      "textDisabled": "#8A93A0",
      "accent": "#0B5FB0",
      "accentText": "#FFFFFF",
      "critical": "#B3261E",
      "criticalSurface": "#FCEEEC",
      "warning": "#8A5300",
      "warningSurface": "#FFF4E3",
      "success": "#0F6B45",
      "successSurface": "#E8F5EE",
      "info": "#0B5FB0",
      "infoSurface": "#E8F1FA"
    },
    "dark": {
      "background": "#0E1116",
      "surface": "#161A21",
      "surfaceRaised": "#1E242D",
      "border": "#333B46",
      "textPrimary": "#F2F4F7",
      "textSecondary": "#B3BCC9",
      "textDisabled": "#6C7684",
      "accent": "#7DB5F0",
      "accentText": "#0E1116",
      "critical": "#F2B8B5",
      "criticalSurface": "#3B1F1D",
      "warning": "#F5C87A",
      "warningSurface": "#3A2A0E",
      "success": "#7FD1A8",
      "successSurface": "#12301F",
      "info": "#7DB5F0",
      "infoSurface": "#132435"
    }
  },
  "spacing": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32,
    "xxxl": 48
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "pill": 999
  },
  "typography": {
    "$comment": "Base sizes only. Both platforms scale these with the OS text-size setting, so nothing here is a fixed pixel size on screen (spec section 7).",
    "display": { "size": 34, "weight": "bold", "lineHeight": 41 },
    "title": { "size": 28, "weight": "bold", "lineHeight": 34 },
    "heading": { "size": 22, "weight": "semibold", "lineHeight": 28 },
    "subheading": { "size": 17, "weight": "semibold", "lineHeight": 22 },
    "body": { "size": 17, "weight": "regular", "lineHeight": 22 },
    "callout": { "size": 16, "weight": "regular", "lineHeight": 21 },
    "caption": { "size": 13, "weight": "regular", "lineHeight": 18 },
    "footnote": { "size": 12, "weight": "regular", "lineHeight": 16 }
  },
  "semantic": {
    "$comment": "Clinical states. Every one pairs a colour with an icon name, because critical information must never be carried by colour alone (spec section 7).",
    "labNormal": { "color": "success", "icon": "checkmark.circle" },
    "labLow": { "color": "warning", "icon": "arrow.down.circle" },
    "labHigh": { "color": "warning", "icon": "arrow.up.circle" },
    "labCritical": { "color": "critical", "icon": "exclamationmark.triangle.fill" },
    "triageInfo": { "color": "info", "icon": "info.circle" },
    "triageRoutine": { "color": "success", "icon": "clock" },
    "triageUrgent": { "color": "warning", "icon": "exclamationmark.circle" },
    "triageEmergency": { "color": "critical", "icon": "exclamationmark.triangle.fill" }
  }
}
