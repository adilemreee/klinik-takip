# Copy to /opt/klinik/observability/infra/compose/.env
# then: chmod 600 .env

# --- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=              # openssl rand -base64 24
GRAFANA_ROOT_URL=http://localhost:8126

# --- GlitchTip -------------------------------------------------------------
GLITCHTIP_DB_PASSWORD=               # openssl rand -hex 24
SECRET_KEY=                          # openssl rand -base64 48
DATABASE_URL=postgres://glitchtip:CHANGEME@glitchtip-postgres:5432/glitchtip
REDIS_URL=redis://glitchtip-redis:6379/0
PORT=8080
GLITCHTIP_DOMAIN=http://localhost:8129

# Anyone who can reach this instance could otherwise create an account and read
# stack traces from a clinical system. Keep this false; invite users instead.
ENABLE_OPEN_USER_REGISTRATION=False
ENABLE_ORGANIZATION_CREATION=False

# Errors are retained for a month, matching the Loki retention window.
GLITCHTIP_MAX_EVENT_LIFE_DAYS=30
CELERY_WORKER_AUTOSCALE=1,3
